{
  "name": "entel-gazete",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-entel --import=.emulator-data --export-on-exit=.emulator-data",
    "emulators:fresh": "npm --prefix functions run build && firebase emulators:start --project demo-entel",
    "seed": "node scripts/seed.ts",
    "add-admin": "node scripts/add-admin.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-entel-rules \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "assets:extract": "node scripts/extract-design-assets.ts",
    "deploy:preview": "ng build && firebase hosting:channel:deploy onizleme --project entel-gazete --expires 7d",
    "deploy:live": "ng build && firebase deploy --project entel-gazete --only hosting,functions,firestore,storage"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
